# Copy to .env for local configuration. Never commit .env or real credentials.
# Development defaults to demo mode with admin@horus.local / HorusDemo2026!.
# Explicit DEMO_MODE=true also permits a clearly identified production demo.
DEMO_MODE=true
PORT=3001
DATA_DIR=.local

# Real deployment: set DEMO_MODE=false and a separate persistent DATA_DIR.
# ADMIN_EMAIL and ADMIN_PASSWORD initialize the first administrator only.
# Changing these variables does not overwrite an existing user's password.
# To reset a stored administrator password securely, use an interactive terminal:
# node server/reset-password.mjs
# The command asks for email and a hidden password, then revokes that user's sessions.
# ADMIN_EMAIL=administrador@example.com
# ADMIN_PASSWORD=generate-a-unique-password-with-at-least-12-characters
# ADMIN_NAME=Administrador HORUS

# Production cookies are Secure by default: deploy behind HTTPS.
# PUBLIC_ORIGIN=https://horus.example.com
# TRUST_PROXY=1
# COOKIE_SECURE=true
